{
  "version": 2,
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/public",
  "installCommand": "pnpm install",
  "framework": null,
  "functions": {
    "dist/api/index.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/dist/api"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/dist/api"
    },
    {
      "source": "/rss.xml",
      "destination": "/dist/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
